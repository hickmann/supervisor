{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoterapIA",
  "version": "0.1.1",
  "identifier": "com.coterapia.copiloto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "CoterapIA - AI Assistant",
        "width": 700,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": "" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "info.plist", 
      "coterapia.desktop",
      "../whisper/**/*"
    ],
    "externalBin": [],
    "macOS": { 
      "minimumSystemVersion": "10.13",
      "frameworks": [],
      "exceptionDomain": "localhost"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": false,
      "wix": {
        "language": ["pt-BR"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libasound2",
          "libpulse0",
          "ffmpeg"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://coterapia.com.br/api/update"],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
